# Copy to .env — the Prisma CLI reads .env only, Next.js reads .env and .env.local.
DATABASE_URL="postgresql://..."        # Neon or Supabase pooled connection string
ANTHROPIC_API_KEY="sk-ant-..."        # required when AI_PROVIDER=anthropic (the default)
# GEMINI_API_KEY="AIza..."             # required instead when AI_PROVIDER=gemini
STORAGE_DRIVER="local"                 # local | blob — must be blob on a serverless host
BLOB_READ_WRITE_TOKEN=""               # only when STORAGE_DRIVER=blob

# Authentication — enforced in production only, so local `npm run dev` needs none of this.
# See "Deploying" in README.md.
# AUTH_SECRET=""                       # npx auth secret
# AUTH_GITHUB_ID=""                    # GitHub OAuth app
# AUTH_GITHUB_SECRET=""
# AUTH_URL="https://your-app.vercel.app"
# OWNER_EMAIL=""                       # the one account allowed in; unset means nobody is

# Optional — sensible defaults, override only when you mean to.
# AI_PROVIDER="anthropic"              # anthropic | gemini
# ANTHROPIC_MODEL="claude-opus-5"      # any Anthropic model id; pricing follows it
# GEMINI_MODEL="gemini-3.5-flash"      # any Gemini model id; pricing follows it
# MAP_REDUCE_TOKEN_THRESHOLD="120000"  # lower it to exercise the map-reduce path
