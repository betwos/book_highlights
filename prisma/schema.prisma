generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection string. Migrations cannot run through a transaction-mode
  // pooler, so run them with DATABASE_URL overridden to the direct (unpooled)
  // string instead — see "Deploying" in README.md. Kept as a single variable so
  // local development, where the two are the same, needs no extra config.
  url      = env("DATABASE_URL")
}

model Book {
  id            String      @id @default(cuid())
  userId        String      @default("local")
  title         String
  subtitle      String?
  author        String
  isbn          String?
  publisher     String?
  publishedYear Int?
  pageCount     Int?
  coverUrl      String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  highlights    Highlight[]
  analyses      Analysis[]

  @@index([userId, updatedAt])
}

model Highlight {
  id            String       @id @default(cuid())
  bookId        String
  book          Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  text          String
  note          String?
  location      String?
  locationType  String? // "page" | "location" | "offset" | null
  color         String?
  tags          String[]     @default([])
  highlightedAt DateTime?
  orderIndex    Int          @default(0)
  contentHash   String
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([bookId, contentHash])
  @@index([bookId, orderIndex])
}

model ImportBatch {
  id            String       @id @default(cuid())
  /// Owner of the staged rows. Without it the commit route can only check that a
  /// batch id exists, which lets any signed-in account import another account's
  /// staged highlight text into its own books.
  userId        String       @default("local")
  filename      String
  rowCount      Int
  importedCount Int          @default(0)
  skippedCount  Int          @default(0)
  mapping       Json
  stagedRows    Json?
  status        ImportStatus @default(pending)
  createdAt     DateTime     @default(now())
  highlights    Highlight[]

  @@index([userId, status, createdAt])
}

model Analysis {
  id               String         @id @default(cuid())
  bookId           String
  book             Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status           AnalysisStatus @default(queued)
  model            String
  promptVersion    String
  highlightSetHash String
  highlightCount   Int
  takeaways        Json?
  chapters         Json?
  chaptersMeta     Json? // { bookRecognized, caveat? }
  error            String?
  tokensIn         Int?
  tokensOut        Int?
  cachedTokensRead Int?
  costCents        Int?
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([bookId, createdAt])
  @@index([bookId, highlightSetHash, promptVersion, model])
}

/// A remembered header -> canonical field decision. The first file that says
/// "quote" costs one model call; every later file with that header is free and
/// deterministic (SPEC 8.3 — mapping is still always shown and editable).
model ColumnAlias {
  id           String   @id @default(cuid())
  userId       String   @default("local")
  headerKey    String // normalized header: lowercased, separators stripped
  headerSample String // the header as spelled in the file that taught us this
  field        String? // canonical field name, or null for "do not import"
  source       String // "user" | "llm"
  timesSeen    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, headerKey])
}

/// A registered reader. SPEC 15 put auth and multi-user out of scope for v1;
/// both are in scope now, and `userId` on the other models — which has always
/// been there (SPEC 4.10) — is what makes each library private.
///
/// Deliberately not a foreign key from Book/Highlight/ColumnAlias: rows created
/// before this model existed carry userId "local" and would violate it. See
/// scripts/claim-library.ts for moving them to a real account.
model User {
  id            String    @id @default(cuid())
  /// Stored lowercased and trimmed; the unique index is what makes it the login.
  email         String    @unique
  /// bcrypt. Never the password itself, and never returned to the client.
  passwordHash  String
  /// Null until a confirmation code is consumed. Sign-in is refused while null.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  codes VerificationCode[]
}

/// A one-time email confirmation code. The code itself is never stored — only a
/// sha256 of it — so a leaked database does not hand over live codes.
model VerificationCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  /// Set when redeemed. A consumed code is never accepted again.
  consumedAt  DateTime?
  /// Wrong guesses against this code; too many and it is dead.
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

enum ImportStatus {
  pending
  committed
  discarded
}

enum AnalysisStatus {
  queued
  running
  succeeded
  failed
}
